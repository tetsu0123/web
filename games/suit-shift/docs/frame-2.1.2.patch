--- /dev/null
+++ b/src/frame.css
@@ -0,0 +1,29 @@
+/* Frame clearance only: the card grid, its dimensions and hit targets do not move. */
+.play-area { --frame-clearance:8px; }
+.play-area::before {
+  inset:calc(-10px - var(--frame-clearance));
+  border-radius:28px;
+  box-shadow:0 1px 0 #f5dc9d20,0 2px 0 #050c08,0 4px 10px #0005,
+    inset 0 2px 1px #f1e2bc20,inset 1px 0 2px #efd3a018,inset -1px -3px 3px #000e;
+}
+.play-area::after {
+  inset:calc(-5px - var(--frame-clearance));
+  border-radius:23px;
+}
+/* The cloth extends past the last row/column; the rail no longer touches them. */
+.board { isolation:isolate;box-shadow:none; }
+.board::before {
+  display:block;content:'';position:absolute;
+  inset:calc(-1 * var(--frame-clearance));
+  border:0;border-radius:18px;background:inherit;
+  box-shadow:inset 0 2px 4px #0004;
+  z-index:-1;pointer-events:none;
+}
+/* Reserve visual separation from the enlarged rail without resizing the cards. */
+.par-label { transform:translateY(-5px); }
+.message { transform:translateY(6px); }
+@media (max-height:680px) {
+  .play-area::before { inset:calc(-8px - var(--frame-clearance));border-radius:26px; }
+  .play-area::after { inset:calc(-5px - var(--frame-clearance));border-radius:23px; }
+  .message { transform:translateY(4px); }
+}
